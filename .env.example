# Copy to server/.env — read ONLY by the Node proxy, never by the browser.

# Provider for Live API mode: "anthropic" (default) or "openai" (any OpenAI-compatible endpoint)
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible (only used when LLM_PROVIDER=openai). A key is required unless
# OPENAI_BASE_URL points at this machine or a private network. For Ollama:
#   LLM_PROVIDER=openai   OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=llama3.2:1b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Proxy port (Vite forwards /api here in dev)
PORT=8787
# Interface the proxy listens on. Loopback by default: anyone who can reach the proxy can spend your key.
# PROXY_HOST=127.0.0.1

# Lab mode: the Python server in lab-server/ (see README). The proxy forwards /api/lab/* here.
LAB_SERVER_URL=http://localhost:8788
# Model the lab server loads (set in the lab server's environment, not here):
#   LAB_MODEL=distilgpt2   (default, ~350 MB)   |   LAB_MODEL=gpt2   |   LAB_MODEL=EleutherAI/pythia-70m
# Lab server limits (also its environment): attention data grows with the square of the prompt length.
#   LAB_MAX_PROMPT_TOKENS=128   LAB_MAX_OUTPUT_TOKENS=128
